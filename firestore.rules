rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'username', 'photoURL', 'about', 'publicKey', 'isOnline', 'lastSeen', 'createdAt', 'updatedAt', 'profileCompleted', 'privacySettings'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 65536))
        && (!('about' in data) || (data.about is string && data.about.size() <= 500))
        && (!('publicKey' in data) || (data.publicKey is string && data.publicKey.size() <= 4096))
        && (!('profileCompleted' in data) || data.profileCompleted is bool)
        && (!('privacySettings' in data) || data.privacySettings is map)
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    function isValidUsername(data) {
      return data.keys().hasAll(['username', 'uid', 'createdAt'])
        && data.keys().hasOnly(['username', 'uid', 'createdAt'])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 50
        && data.username.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid is string && data.uid == request.auth.uid;
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'about', 'publicKey', 'isOnline', 'lastSeen', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 65536))
        && (!('about' in data) || (data.about is string && data.about.size() <= 500))
        && (!('publicKey' in data) || (data.publicKey is string && data.publicKey.size() <= 4096))
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    function isValidEmailLookup(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'username', 'photoURL', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && (!('username' in data) || (data.username is string && data.username.size() <= 50))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 65536));
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll(['requestId', 'fromUid', 'toUid', 'status', 'createdAt'])
        && data.keys().hasOnly(['requestId', 'fromUid', 'toUid', 'fromDisplayName', 'fromEmail', 'fromPhotoURL', 'toDisplayName', 'toEmail', 'status', 'createdAt', 'updatedAt'])
        && data.requestId is string && data.requestId.size() <= 256
        && data.fromUid is string && data.fromUid == request.auth.uid
        && data.toUid is string && data.toUid != request.auth.uid && data.toUid.size() <= 128
        && data.status in ['pending', 'accepted', 'rejected', 'cancelled']
        && (!('fromDisplayName' in data) || (data.fromDisplayName is string && data.fromDisplayName.size() <= 100))
        && (!('fromEmail' in data) || (data.fromEmail is string && data.fromEmail.size() <= 256))
        && (!('fromPhotoURL' in data) || (data.fromPhotoURL is string && data.fromPhotoURL.size() <= 65536))
        && (!('toDisplayName' in data) || (data.toDisplayName is string && data.toDisplayName.size() <= 100))
        && (!('toEmail' in data) || (data.toEmail is string && data.toEmail.size() <= 256));
    }

    function isValidFriendship(data) {
      return data.keys().hasAll(['friendshipId', 'userA', 'userB', 'users', 'createdAt'])
        && data.keys().hasOnly(['friendshipId', 'userA', 'userB', 'users', 'createdAt'])
        && data.friendshipId is string && data.friendshipId.size() <= 256
        && data.userA is string && data.userB is string
        && (data.userA == request.auth.uid || data.userB == request.auth.uid)
        && data.users is list && data.users.size() == 2;
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['conversationId', 'participantUids', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['conversationId', 'participantUids', 'participantData', 'lastMessage', 'typing', 'createdAt', 'updatedAt'])
        && data.conversationId is string && data.conversationId.size() <= 256
        && data.participantUids is list && data.participantUids.size() == 2
        && request.auth.uid in data.participantUids;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['messageId', 'conversationId', 'senderId', 'recipientId', 'ciphertext', 'iv', 'status', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'conversationId', 'senderId', 'recipientId', 'ciphertext', 'iv', 'status', 'messageType', 'createdAt'])
        && data.messageId is string && data.messageId.size() <= 128
        && data.conversationId is string && data.conversationId.size() <= 256
        && data.senderId is string && data.senderId == request.auth.uid
        && data.recipientId is string && data.recipientId != request.auth.uid && data.recipientId.size() <= 128
        && data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 65536
        && data.iv is string && data.iv.size() > 0 && data.iv.size() <= 128
        && data.status in ['sending', 'sent', 'delivered', 'read']
        && (!('messageType' in data) || data.messageType in ['text', 'image', 'file']);
    }

    function isValidBlock(data) {
      return data.keys().hasAll(['blockId', 'blockerUid', 'blockedUid', 'createdAt'])
        && data.keys().hasOnly(['blockId', 'blockerUid', 'blockedUid', 'createdAt'])
        && data.blockId is string && data.blockId.size() <= 256
        && data.blockerUid is string && data.blockerUid == request.auth.uid
        && data.blockedUid is string && data.blockedUid != request.auth.uid;
    }

    // 1. Private User Profiles (PII Protected)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Strict PII protection
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Public Profiles
    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidPublicProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 3. Email Lookup Directory (Direct Point-Lookup Only, No Scraping)
    match /emailLookups/{lookupKey} {
      allow get: if isSignedIn() && isValidId(lookupKey);
      allow list: if false; // Block scraping/dumping all registered users
      allow create: if isSignedIn() && isValidId(lookupKey) && isValidEmailLookup(incoming());
      allow update: if isSignedIn() && isValidId(lookupKey) && isValidEmailLookup(incoming())
        && existing().uid == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(lookupKey) && existing().uid == request.auth.uid;
    }

    // 4. Friend Requests
    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId)
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && isValidFriendRequest(incoming());
      allow update: if isSignedIn() && isValidId(requestId)
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid)
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().status in ['pending', 'accepted', 'rejected', 'cancelled'];
      allow delete: if isSignedIn() && isValidId(requestId)
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // 5. Friends Records
    match /friends/{friendshipId} {
      allow get: if isSignedIn() && isValidId(friendshipId)
        && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(friendshipId) && isValidFriendship(incoming());
      allow update: if isSignedIn() && isValidId(friendshipId) && isValidFriendship(incoming())
        && incoming().userA == existing().userA
        && incoming().userB == existing().userB;
      allow delete: if isSignedIn() && isValidId(friendshipId)
        && (existing().userA == request.auth.uid || existing().userB == request.auth.uid);
    }

    // 6. Conversations
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId)
        && request.auth.uid in resource.data.participantUids;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(conversationId) && isValidConversation(incoming());
      allow update: if isSignedIn() && isValidId(conversationId)
        && request.auth.uid in existing().participantUids
        && incoming().conversationId == existing().conversationId
        && incoming().participantUids == existing().participantUids;
      allow delete: if isSignedIn() && isValidId(conversationId)
        && request.auth.uid in existing().participantUids;

      // 7. Messages inside Conversations
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(messageId)
          && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
        allow update: if isSignedIn() && isValidId(messageId)
          && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid)
          && incoming().messageId == existing().messageId
          && incoming().senderId == existing().senderId
          && incoming().recipientId == existing().recipientId
          && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if isSignedIn() && isValidId(messageId)
          && existing().senderId == request.auth.uid;
      }
    }

    // 8. Blocked Users
    match /blocks/{blockId} {
      allow get, list: if isSignedIn() && isValidId(blockId)
        && (resource.data.blockerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(blockId) && isValidBlock(incoming());
      allow delete: if isSignedIn() && isValidId(blockId) && existing().blockerUid == request.auth.uid;
    }

    // 9. Unique Username Registry
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidId(username);
      allow list: if false; // Disallow scraping usernames
      allow create: if isSignedIn() && isValidId(username)
        && isValidUsername(incoming())
        && incoming().username == username
        && incoming().uid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(username)
        && isValidUsername(incoming())
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && incoming().username == username;
      allow delete: if isSignedIn() && isValidId(username)
        && existing().uid == request.auth.uid;
    }

    // 10. Connection test collection (allow auth read for ping test)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
